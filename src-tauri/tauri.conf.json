{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ALOS",
  "version": "0.1.0",
  "identifier": "com.alos.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && python3.11 scripts/build_backend.py"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ALOS",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "ALOS — Autonomous Local Operating System",
    "longDescription": "ALOS is a multi-agent swarm AI system with memory, RBAC, and local-first architecture.",
    "copyright": "",
    "publisher": "ALOS",
    "resources": ["resources/backend/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
